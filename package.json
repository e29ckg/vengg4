{
  "name": "vengg4",
  "version": "1.0.0",
  "private": true,
  "description": "ระบบจัดการเวร Vue + Node.js + MySQL พร้อม MFA และ web installer",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "deps": "npm ci --prefix backend-node && npm ci --prefix frontend",
    "build": "node scripts/build.mjs",
    "install:web": "npm --prefix backend-node run install:web",
    "start": "npm --prefix backend-node start",
    "dev:backend": "npm --prefix backend-node run dev",
    "dev:frontend": "npm --prefix frontend run dev --",
    "migrate": "npm --prefix backend-node run migrate",
    "test": "npm test --prefix backend-node && npm test --prefix frontend",
    "test:integration": "npm --prefix backend-node run test:integration",
    "package": "npm --prefix backend-node run package --"
  }
}
