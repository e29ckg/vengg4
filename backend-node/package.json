{
  "name": "vengg4-node-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env bin/migrate.js",
    "create-admin": "node --env-file-if-exists=.env bin/create-admin.js",
    "notify": "node --env-file-if-exists=.env bin/notify.js",
    "install:web": "node bin/install.js",
    "package": "node bin/package.js",
    "test:isolated": "node tests/run-isolated.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --env-file-if-exists=.env.test --test tests/integration/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
