NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vengg4_db
DB_USER=vengg4_app
DB_PASS=
# Generate two DIFFERENT keys: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SIGNING_KEY=
MFA_ENCRYPTION_KEY=
STORAGE_DIR=./storage
LEGACY_DATA_DIR=./storage/legacy-import
FRONTEND_DIR=../frontend/dist
COOKIE_SECURE=false
# Enable only behind an Apache HTTPS reverse proxy on the same machine.
TRUST_PROXY=false
TRUST_PROXY_CIDRS=loopback
# Optional: GitHub owner/repository, only after creating the new repository.
UPDATE_REPOSITORY=
APP_COMMIT=
